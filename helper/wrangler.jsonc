// Cloudflare builds the Opus helper from this folder (helper/ in the opus repo) on every push.
// The secrets GITHUB_TOKEN and ACCESS_KEY stay in Cloudflare; they are never in this repo.
{
  "name": "opus-helper",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  // Cloudflare's own AI, used only for the free natural voice samples (free daily amount; the free plan stops, never charges)
  "ai": { "binding": "AI" }
}

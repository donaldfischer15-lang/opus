// Cloudflare builds the Opus helper on every push. This copy lets the build work
// whether its root directory is set to helper/ or left blank. Same settings as helper/wrangler.jsonc.
// The secrets GITHUB_TOKEN and ACCESS_KEY stay in Cloudflare; they are never in this repo.
{
  "name": "opus-helper",
  "main": "helper/worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] }
}
